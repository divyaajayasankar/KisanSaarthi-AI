# ============================================================
# KisanSaarthi AI - configuration (copy to .env; never commit .env)
# Only settings the code actually reads are listed here.
# ============================================================

# Weather and place lookup (OpenWeather). Without a key the app still
# runs, but every advisory stops at "weather could not be verified".
OPENWEATHER_API_KEY=

# Database. Default is the local SQLite file.
DATABASE_URL=sqlite:///./kisansaarthi.db

# ------------------------------------------------------------
# Optional LLM (Mode A). Leave LLM_ENABLED=false for the fully
# deterministic Mode B. The LLM never computes doses, PHI, intervals,
# area conversion, thresholds or the ANSWER / ASK_FOLLOW_UP / ABSTAIN decision.
# Any OpenAI-compatible /chat/completions endpoint works.
# ------------------------------------------------------------
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# ------------------------------------------------------------
# Voice input (faster-whisper on CPU). Change only this line to switch
# the model. small = better Hindi/Tamil/Telugu (about 480 MB first
# download); base = faster, about 145 MB, weaker on Tamil and Telugu.
# ------------------------------------------------------------
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_AUDIO_MB=20

# ------------------------------------------------------------
# Decision controller
# confidence >= ANSWER threshold   -> image evidence is used
# between ASK and ANSWER           -> farmer is asked to confirm
# below ASK threshold              -> image evidence is rejected
# ------------------------------------------------------------
VISION_ANSWER_THRESHOLD=0.80
VISION_ASK_THRESHOLD=0.55
MAX_FOLLOW_UP_TURNS=6

# Conversation memory lifetime
CONVERSATION_TTL_HOURS=24

# ------------------------------------------------------------
# WhatsApp Cloud API adapter (POST/GET /api/whatsapp/webhook).
# Tested with simulated Meta payloads only. Without ACCESS_TOKEN and
# PHONE_NUMBER_ID the adapter processes the message and returns the reply
# in the HTTP response (dry run) instead of sending it.
# ------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
