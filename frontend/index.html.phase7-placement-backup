                    <input
                        type="number"
                        id="harvestDays"
                        placeholder="e.g. 40"
                        min="0"
                        required
                    >

                    <div class="field-help">
                        Used to verify the pesticide
                        Pre-Harvest Interval (PHI).
                    </div>

                </div>


                <!-- ===========================================
                     GROWTH STAGE
                ============================================ -->

                <div class="form-group full">

                    <label for="growthStage">
                        Crop Growth Stage
                    </label>

                    <select
                        id="growthStage"
                    >

                        <option
                            value=""
                            selected
                        >
                            Select growth stage
                        </option>

                        <option value="sowing">
                            Sowing
                        </option>

                        <option value="seedling">
                            Seedling
                        </option>

                        <option value="vegetative">
                            Vegetative
                        </option>

                        <option value="reproductive">
                            Flowering / Reproductive
                        </option>

                        <option value="pre_harvest">
                            Pre-Harvest
                        </option>

                    </select>

                    <div class="field-help">
