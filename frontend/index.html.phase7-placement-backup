                        required
                    >

                </div>


                <!-- ===========================================
                     FIELD AREA
                ============================================ -->

                <div class="form-group">

                    <label for="fieldArea">
                        Field Area
                    </label>

                    <input
                        type="number"
                        id="fieldArea"
                        placeholder="Enter area"
                        step="0.01"
                        min="0.01"
                        required
                    >

                </div>


                <!-- ===========================================
                     AREA UNIT
                ============================================ -->

                <div class="form-group">

                    <label for="areaUnit">
                        Area Unit
